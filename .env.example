# Man Matters Companion — Environment Variables
# Copy to .env.local for local development. Never commit real keys.

# Gemini API Key (Server-side only — NEVER use NEXT_PUBLIC_)
GEMINI_API_KEY=your_gemini_api_key_here

# Model name (default: gemini-1.5-flash or gemini-2.5-flash)
GEMINI_MODEL=gemini-1.5-flash
